---
import { useTranslations, localizedPath } from '../i18n/utils';
import { cases } from '../data/cases';
import CaseCard from '../components/CaseCard.astro';

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <span class="eyebrow">{t.portfolio.eyebrow}</span>
        <h2>{t.portfolio.title}</h2>
      </div>
      <a href={localizedPath(lang, 'portfolio')} class="btn btn--ghost btn--sm">{t.portfolio.linkAll} →</a>
    </div>

    <div class="grid-auto">
      {cases.map((item) => {
        const caseT = t.portfolio.cases[item.id];
        return (
          <CaseCard
            title={caseT.title}
            category={caseT.category}
            description={caseT.description}
            url={item.url}
            domain={item.domain}
            year={item.year}
            image={item.image}
            visitLabel={t.portfolio.visitSite}
          />
        );
      })}
    </div>
  </div>
</section>
